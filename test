    </section>
  </div>
  <div class="toast" id="toast" role="status"></div>

  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
  <script>
    const SUPABASE_URL = 'https://coohctqlvntvqmmlyoxl.supabase.co';
    const SUPABASE_PUBLISHABLE_KEY = 'sb_publishable_h3Gcu8-NMbGAI-TfUxxCRA_gGKwjW2X';
    const SELLER_EMAIL = 'xyaphe2@gmail.com';
    const supabaseClient = window.supabase.createClient(SUPABASE_URL, SUPABASE_PUBLISHABLE_KEY);
    let currentUser = null;
    let products = [];

    const state = { category: 'All', search: '', sort: 'featured', cart: loadCart() };

    function normalizeProduct(row) {
      return { id: row.id, name: row.text || 'Untitled product', category: row.category || 'Home', price: Number(row.price) || 0, oldPrice: row.old_price ? Number(row.old_price) : Number(row.price) || 0, rating: Number(row.rating) || 5, reviews: Number(row.reviews) || 0, badge: row.badge || 'New', emoji: row.emoji || '✦', accent: row.accent || '#dce6dc', description: row.desc || '', image: row.image || '' };
    }
    async function loadPublishedProducts() {
      const { data, error } = await supabaseClient.from('products').select('*').order('created_at', { ascending: false });
      if (!error && data && data.length) { products = [...data.map(normalizeProduct), ...products]; renderCategories(); renderProducts(); }
    }
    async function updateAuthUI(session) {
      currentUser = session && session.user ? session.user : null;
      const button = $('#authBtn');
      const sellerPanel = $('#sellerPanel');
      const isSeller = currentUser && (currentUser.email || '').toLowerCase() === SELLER_EMAIL;
      sellerPanel.classList.toggle('visible', Boolean(isSeller));
      if (currentUser) {
        const label = currentUser.user_metadata?.full_name || currentUser.user_metadata?.name || currentUser.email || 'Account';
        button.textContent = `${label.slice(0, 18)} · Sign out`;
        button.classList.add('signed-in');
      } else {
        button.textContent = 'Sign in with Discord';
        button.classList.remove('signed-in');
      }
    }
    async function signInWithDiscord() {
      const redirectTo = window.location.origin === 'null' ? window.location.href.split('#')[0] : `${window.location.origin}${window.location.pathname}`;
      const { error } = await supabaseClient.auth.signInWithOAuth({ provider: 'discord', options: { redirectTo } });
      if (error) showToast(error.message);
    }
    async function signOut() {
      const { error } = await supabaseClient.auth.signOut();
      if (error) showToast(error.message); else showToast('Signed out');
    }
    async function uploadProduct(event) {
      event.preventDefault();
      const form = event.target;
      const status = $('#sellerStatus');
      if (!currentUser || (currentUser.email || '').toLowerCase() !== SELLER_EMAIL) { status.textContent = 'Only the authorized seller account can publish.'; return; }
      const file = form.image.files[0];
      if (!file) { status.textContent = 'Please choose an image.'; return; }
      if (file.size > 8 * 1024 * 1024) { status.textContent = 'Please use an image smaller than 8 MB.'; return; }
      status.textContent = 'Uploading image and publishing product…';
      const safeName = file.name.toLowerCase().replace(/[^a-z0-9.\-_]/g, '-');
      const path = `${crypto.randomUUID()}-${safeName}`;
      const upload = await supabaseClient.storage.from('product-images').upload(path, file, { upsert: false, contentType: file.type });
      if (upload.error) { status.textContent = upload.error.message; return; }
      const publicUrl = supabaseClient.storage.from('product-images').getPublicUrl(path).data.publicUrl;
      const formData = new FormData(form);
      const payload = { image: publicUrl, price: Number(formData.get('price')), text: formData.get('text'), desc: formData.get('desc'), category: formData.get('category'), seller_email: SELLER_EMAIL };
      const { data, error } = await supabaseClient.from('products').insert(payload).select().single();
      if (error) { status.textContent = error.message; return; }
      products.unshift(normalizeProduct(data));
      renderCategories(); renderProducts(); form.reset(); status.textContent = 'Published successfully. Your product is now in the edit.'; showToast('Product published');
    }
    const $ = (selector) => document.querySelector(selector);
    const money = (value) => `$${value.toFixed(2)}`;

    function loadCart() {
      try { return JSON.parse(localStorage.getItem('niwgarmz-cart') || '[]'); } catch (error) { return []; }
    }
    function saveCart() {
      try { localStorage.setItem('niwgarmz-cart', JSON.stringify(state.cart)); } catch (error) {}
    }
    function showToast(message) {
      const toast = $('#toast');
      toast.textContent = message;
      toast.classList.add('show');
      clearTimeout(window.toastTimer);
      window.toastTimer = setTimeout(() => toast.classList.remove('show'), 2400);
    }

    function renderCategories() {
      const categories = ['All', ...new Set(products.map(product => product.category))];
      $('#categories').innerHTML = categories.map(category => `<button class="category-chip ${state.category === category ? 'active' : ''}" data-category="${category}">${category}</button>`).join('');
    }

    function filteredProducts() {
      let list = products.filter(product => {
        const matchesCategory = state.category === 'All' || product.category === state.category;
        const query = state.search.toLowerCase().trim();
        const matchesSearch = !query || `${product.name} ${product.category} ${product.description}`.toLowerCase().includes(query);
        return matchesCategory && matchesSearch;
      });
      if (state.sort === 'low') list.sort((a, b) => a.price - b.price);
      if (state.sort === 'high') list.sort((a, b) => b.price - a.price);
      if (state.sort === 'rating') list.sort((a, b) => b.rating - a.rating);
      return list;
    }

    function renderProducts() {
      const list = filteredProducts();
      const grid = $('#productGrid');
      if (!list.length) {
        grid.innerHTML = `<div class="empty-products">No products matched that search. Products published by the admin will appear here.</div>`;
        return;
      }
      grid.innerHTML = list.map(product => `
        <article class="product-card">
          <div class="product-visual" style="--accent:${product.accent}">
            <span class="product-badge">${product.badge}</span>
            <button class="favorite" aria-label="Add ${product.name} to favourites">♡</button>
            ${product.image ? `<img class="product-photo" src="${product.image}" alt="${product.name}">` : `<span class="product-emoji" aria-hidden="true">${product.emoji || '✦'}</span>`}
          </div>
          <div class="product-info">
            <div class="product-meta"><h3 class="product-name">${product.name}</h3><div class="price">${money(product.price)}<span class="old-price">${money(product.oldPrice)}</span></div></div>
            <div class="stars" aria-label="${product.rating} out of 5 stars">★★★★★ <span>${product.rating} (${product.reviews})</span></div>
            <div class="card-actions"><button class="add-btn" data-purchase="${product.id}">Purchase</button><button class="quick-btn" data-quick="${product.id}" aria-label="Quick view ${product.name}">↗</button></div>
          </div>
        </article>`).join('');
    }

    function cartQuantity() { return state.cart.reduce((sum, item) => sum + item.quantity, 0); }
    function cartSubtotal() { return state.cart.reduce((sum, item) => { const product = products.find(product => product.id === item.id); return sum + product.price * item.quantity; }, 0); }
    function addToCart(id) {
      const existing = state.cart.find(item => item.id === id);
      if (existing) existing.quantity += 1; else state.cart.push({ id, quantity: 1 });
      saveCart(); renderCart();
      const product = products.find(item => item.id === id);
      showToast(`${product.name} added to your bag`);
    }
    function updateQuantity(id, amount) {
      const item = state.cart.find(cartItem => cartItem.id === id);
      if (!item) return;
      item.quantity += amount;
      if (item.quantity <= 0) state.cart = state.cart.filter(cartItem => cartItem.id !== id);
      saveCart(); renderCart();
    }
    function removeFromCart(id) { state.cart = state.cart.filter(item => item.id !== id); saveCart(); renderCart(); }

    function renderCart() {
      const totalQuantity = cartQuantity();
      $('#cartCount').textContent = totalQuantity;
      $('#drawerCount').textContent = totalQuantity ? `(${totalQuantity})` : '';
      $('#subtotal').textContent = money(cartSubtotal());
      const target = $('#cartItems');
      if (!state.cart.length) {
        target.innerHTML = '<div class="empty-cart"><span class="empty-icon">✦</span>Your bag is feeling light.<br>Add something lovely to get started.</div>';
        return;
      }
      target.innerHTML = state.cart.map(item => {
        const product = products.find(product => product.id === item.id);
        return `<div class="cart-item"><div class="cart-item-art" style="--accent:${product.accent}">${product.emoji}</div><div><p class="cart-item-name">${product.name}</p><div class="cart-item-price">${money(product.price)}</div><div class="quantity"><button data-minus="${product.id}" aria-label="Decrease quantity">−</button><span>${item.quantity}</span><button data-plus="${product.id}" aria-label="Increase quantity">+</button></div></div><button class="remove-item" data-remove="${product.id}" aria-label="Remove ${product.name}">×</button></div>`;
      }).join('');
    }

    function openCart() { $('#cartOverlay').classList.add('open'); $('#cartOverlay').setAttribute('aria-hidden', 'false'); document.body.style.overflow = 'hidden'; }
    function closeCart() { $('#cartOverlay').classList.remove('open'); $('#cartOverlay').setAttribute('aria-hidden', 'true'); document.body.style.overflow = ''; }
    function openQuickView(id) {
      const product = products.find(item => item.id === id);
      $('#modalVisual').style.setProperty('--accent', product.accent);
      $('#modalVisual').innerHTML = product.image ? `<img class="product-photo" src="${product.image}" alt="${product.name}">` : `<span class="product-emoji" id="modalEmoji">${product.emoji || '✦'}</span>`;
      $('#modalName').textContent = product.name;
      $('#modalPrice').textContent = money(product.price);
      $('#modalDescription').textContent = product.description;
      $('#modalAdd').dataset.addModal = product.id;
      $('#modalPurchase').dataset.purchaseModal = product.id;
      $('#modalWrap').classList.add('open'); $('#modalWrap').setAttribute('aria-hidden', 'false'); document.body.style.overflow = 'hidden';
    }
    function openPurchase(id) {
      const product = products.find(item => item.id === id);
      if (!product) return;
      $('#purchaseWrap').dataset.product = id;
      $('#purchaseWrap').classList.add('open'); $('#purchaseWrap').setAttribute('aria-hidden', 'false'); document.body.style.overflow = 'hidden';
    }
    function closeModal() { $('#modalWrap').classList.remove('open'); $('#modalWrap').setAttribute('aria-hidden', 'true'); document.body.style.overflow = ''; }
    function closePurchase() { $('#purchaseWrap').classList.remove('open'); $('#purchaseWrap').setAttribute('aria-hidden', 'true'); document.body.style.overflow = ''; }

    document.addEventListener('click', event => {
      const categoryButton = event.target.closest('[data-category]');
      if (categoryButton) { state.category = categoryButton.dataset.category; renderCategories(); renderProducts(); }
      const navCategory = event.target.closest('[data-nav-category]');
      if (navCategory) { state.category = navCategory.dataset.navCategory; renderCategories(); renderProducts(); $('#navLinks').classList.remove('open'); }
      const addButton = event.target.closest('[data-add]');
      if (addButton) addToCart(Number(addButton.dataset.add));
      const purchaseButton = event.target.closest('[data-purchase]');
      if (purchaseButton) openPurchase(Number(purchaseButton.dataset.purchase));
      const modalPurchase = event.target.closest('[data-purchase-modal]');
      if (modalPurchase) { closeModal(); openPurchase(Number(modalPurchase.dataset.purchaseModal)); }
      const modalAdd = event.target.closest('[data-add-modal]');
      if (modalAdd) { addToCart(Number(modalAdd.dataset.addModal)); closeModal(); }
      const quickButton = event.target.closest('[data-quick]');
      if (quickButton) openQuickView(Number(quickButton.dataset.quick));
      const plus = event.target.closest('[data-plus]');
      if (plus) updateQuantity(Number(plus.dataset.plus), 1);
      const minus = event.target.closest('[data-minus]');
      if (minus) updateQuantity(Number(minus.dataset.minus), -1);
      const remove = event.target.closest('[data-remove]');
      if (remove) removeFromCart(Number(remove.dataset.remove));
      const favorite = event.target.closest('.favorite');
      if (favorite) { favorite.classList.toggle('liked'); favorite.textContent = favorite.classList.contains('liked') ? '♥' : '♡'; }
    });

    $('#authBtn').addEventListener('click', () => currentUser ? signOut() : signInWithDiscord());
    $('#signOutBtn').addEventListener('click', signOut);
    $('#sellerForm').addEventListener('submit', uploadProduct);
    supabaseClient.auth.onAuthStateChange((_event, session) => updateAuthUI(session));
    supabaseClient.auth.getSession().then(({ data }) => updateAuthUI(data.session));
    $('#openCart').addEventListener('click', openCart);
    $('#closeCart').addEventListener('click', closeCart);
    $('#cartOverlay').addEventListener('click', event => { if (event.target === $('#cartOverlay')) closeCart(); });
    $('#closeModal').addEventListener('click', closeModal);
    $('#modalWrap').addEventListener('click', event => { if (event.target === $('#modalWrap')) closeModal(); });
    $('#closePurchase').addEventListener('click', closePurchase);
    $('#purchaseWrap').addEventListener('click', event => { if (event.target === $('#purchaseWrap')) closePurchase(); });
    $('#copySnapchat').addEventListener('click', async () => { try { await navigator.clipboard.writeText('niwgarmz'); showToast('Snapchat username copied'); } catch (error) { showToast('Snapchat username: niwgarmz'); } });
    $('#searchInput').addEventListener('input', event => { state.search = event.target.value; renderProducts(); });
    $('#sortSelect').addEventListener('change', event => { state.sort = event.target.value; renderProducts(); });
    $('#searchFocus').addEventListener('click', () => { document.querySelector('#shop').scrollIntoView({ behavior: 'smooth' }); setTimeout(() => $('#searchInput').focus(), 500); });
    $('#menuToggle').addEventListener('click', () => $('#navLinks').classList.toggle('open'));
    $('#checkoutBtn').addEventListener('click', () => { if (!state.cart.length) showToast('Your bag is empty'); else showToast('Checkout is ready for your payment setup'); });
    $('#subscribeForm').addEventListener('submit', event => { event.preventDefault(); event.target.reset(); showToast('You are on the good list — welcome in'); });
    document.addEventListener('keydown', event => { if (event.key === 'Escape') { closeCart(); closeModal(); closePurchase(); } });

    renderCategories(); renderProducts(); renderCart(); loadPublishedProducts();
  </script>
</body>
